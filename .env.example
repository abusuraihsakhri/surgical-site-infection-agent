# Surgical Site Infection Agent — Environment Configuration
# Copy this file to .env and customize for your deployment.

# HMAC-SHA256 Audit Trail Secret Key
# MUST be set to a strong, unique value in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=

# LLM Provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
